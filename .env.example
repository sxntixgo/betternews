# Fallback endpoint. Can be overridden at runtime in Settings → Ollama → Connection
# (which takes effect on the next pipeline run, without rebuilding the container).
DATABASE_URL=postgresql+psycopg://betterread:betterread@db:5432/betterread
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB configure the db service.

# Retention: articles older than this are pruned. 0 disables. Inert until
# confirmed in Settings > Storage > Retention.
RETENTION_DAYS=15

# Set to 1 to run the scheduler inside the web process instead of the worker
# container. Only safe with a single gunicorn worker.
# RUN_SCHEDULER_IN_WEB=1

OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_TIMEOUT=180
SCORING_MODEL=llama3.2:3b
SUMMARY_MODEL=llama3.2:3b
SCORE_THRESHOLD=0.35
POLL_INTERVAL_MINUTES=30
FLASK_SECRET_KEY=change-me-to-a-random-string
